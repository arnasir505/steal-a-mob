-- GameConfig: общие настройки игры.
-- ВСЕ ЧИСЛА ЗДЕСЬ ВРЕМЕННЫЕ. Меняй их при балансе — код трогать не нужно.

local GameConfig = {}

-- Имя хранилища данных. Если поменять, у всех игроков начнётся новый прогресс.
GameConfig.DataStoreName = "PlayerData_v1"

-- Как часто сохранять данные игроков (секунды)
GameConfig.AutosaveInterval = 60

-- Раунды: каждые 5 минут всех выкидывает в safe zone и яйца обновляются
GameConfig.Round = {
	Duration = 5 * 60,    -- длина раунда
	WarningBefore = 10,   -- за сколько секунд предупреждать о сбросе
	CloseDuration = 10,    -- сколько секунд ворота стоят закрытыми во время сброса
	ClosedGateTransparency = 0.5, -- насколько видно закрытые ворота, если автор сделал их невидимыми
}

-- Зоны (safe zone и биомы). Деталь Area можно делать хоть плоской плитой на полу,
-- хоть высокой коробкой: по высоте проверка прощает, потому что центр персонажа
-- всегда выше пола, а сплошную коробку игрок вообще обходит сверху.
GameConfig.Zone = {
	HeightAbove = 60, -- на сколько студов над зоной игрок ещё считается внутри
	HeightBelow = 15, -- и на сколько ниже
}

-- Яйца в биомах
GameConfig.Egg = {
	CarryHeight = 4,           -- на какой высоте над игроком висит яйцо
	SpawnMinDistance = 1,     -- минимальное расстояние между яйцами в биоме
	SpawnTries = 25,           -- сколько раз пробовать найти свободную точку
	SpawnHeightAbove = 60,     -- с какой высоты искать пол под точкой спавна
	PickupDistance = 12,       -- с какого расстояния можно взять яйцо
	PickupHoldTime = 1,        -- сколько секунд держать E, чтобы поднять яйцо (0 — сразу)
	CheckInterval = 0.2,       -- как часто проверять, донёс ли игрок яйцо до safe zone
	DropDistance = 3,          -- на сколько студов впереди игрока падает брошенное яйцо
	DropCooldown = 0.5,        -- защита от спама кнопкой "бросить"
}

-- Боссы биомов (BossService). Скорость и сила толчка у каждого босса свои —
-- они в Config/Biomes (Boss.Speed и Boss.Knockback). Здесь общее для всех.
GameConfig.Boss = {
	TickInterval = 0.1,        -- как часто босс выбирает цель и поправляет курс (секунды)
	WakeUpTime = 0.5,          -- сколько секунд босс просыпается, прежде чем побежать (0 — сразу)
	CatchDistance = 4,         -- на каком расстоянии от края босса он ловит игрока (студы)
	CatchHeight = 12,          -- насколько игрок может быть выше или ниже босса и всё равно попасться
	ReturnSpeedShare = 0.6,    -- домой босс идёт шагом: такая доля от его скорости в погоне
	ReturnTimeout = 20,        -- не дошёл до места за столько секунд (застрял) — появляется там сам
	FallLimit = 150,           -- провалился ниже места сна на столько студов — возвращается на место
	OutsideCatchDropsEgg = true, -- false: за пределами биома босс только толкает, яйцо остаётся у игрока.
	                              -- true: толчок выбивает яйцо на землю
	RagdollTime = 2,         -- сколько секунд игрок лежит после толчка босса, потом встаёт
	CarryInterruptible = true, -- босс несёт отобранное яйцо на место, а кто-то крадёт другое:
	                           -- true — ставит яйцо на место сразу и бросается в погоню,
	                           -- false — сначала донесёт (вдвоём его так легко обмануть)

	-- Стандартные анимации Roblox — ими может пользоваться любая игра.
	-- Берутся, когда у босса нет своей анимации для состояния или своя
	-- не загрузилась (например, она чужая и к ней нет доступа).
	-- Работают только на обычном риге R15 или R6 (стандартные имена суставов).
	-- Анимации сна у Roblox нет — вместо неё стоит обычная анимация покоя.
	DefaultAnimations = {
		R15 = {
			Run = "rbxassetid://913376220",   -- та же, что на беговой дорожке
			Walk = "rbxassetid://507777826",
			Sleep = "rbxassetid://507766388",
		},
		R6 = {
			Run = "rbxassetid://180426354",
			Walk = "rbxassetid://180426354",
			Sleep = "rbxassetid://180435571",
		},
	},
	AnimationLoadTimeout = 5,  -- сколько секунд ждать свою анимацию, прежде чем взять стандартную
}

-- Толчок (босс сейчас, меч на этапе 6). Сила толчка — у каждого босса и меча своя.
-- Сила толчка (Boss.Knockback, Knockback меча) — скорость полёта по земле в студах в секунду.
-- Примерно: дальность полёта = сила x (Time + 2 x подъём / 196). Сила 80 — ~40 студов,
-- 600 — ~1300 студов, 1200 — ~2900 студов.
GameConfig.Knockback = {
	Time = 0.15,               -- сколько секунд длится разгон, дальше игрок летит сам
	UpShare = 0.35,            -- доля толчка вверх (0 — толкает только по земле)
	MaxUpSpeed = 220,          -- предел скорости вверх: выше ~120 студов не взлетает,
	                           -- поэтому не перелетает невидимые стены (BARRIER_HEIGHT в BlockWorld)
	BrakeTime = 0.6,           -- после приземления столько секунд гасим скольжение по земле
	BrakeForce = 2500,         -- сила торможения (на единицу массы)
}

-- Вес мобов и яиц
GameConfig.Weight = {
	Min = 1,                 -- 1 кг
	Max = 100000000,         -- 100 млн кг
	IncomeExponent = 0.5,    -- доход растёт как вес^0.5 (1 кг = x1, 100 кг = x10, 100 млн кг = x10000)
	HatchTimePerLog = 0.15,  -- +15% ко времени вылупления за каждые x10 веса

	-- Размер модели. Размер при 1 кг = модель как в Studio x Scale из Config/Mobs.
	-- MaxModelScale   — во сколько раз модель больше при максимальном весе (100 млн кг).
	-- ModelScaleCurve — как долго модель остаётся маленькой:
	--     1 = растёт равномерно (при 50 уже 2 кг = x2.8, 10 кг = x7)
	--     2 = маленькая дольше  (10 кг = x1.8, 1 000 кг = x7.9)
	--     3 = почти не растёт до тысяч кг, потом резко:
	--         10 кг = x1.1,  1 000 кг = x3.6,  100 000 кг = x13,
	--         1 млн кг = x22,  10 млн кг = x34,  100 млн кг = x50
	-- Проверить свои числа: тестовая команда !formulas (колонки scale и egg).
	-- Деталь в Roblox не бывает больше 2048 студов: самая крупная деталь модели,
	-- умноженная на MaxModelScale, должна в это укладываться.
	MaxModelScale = 50,
	ModelScaleCurve = 3,
	-- Яйца растут по той же кривой, но до своего предела: яйцо несут над головой,
	-- и огромное закрыло бы игроку весь обзор
	EggMaxModelScale = 20 ,
	CarrySlowPerLog = 0.08,  -- -8% скорости за каждые x10 веса несомого яйца
	MinCarryMultiplier = 0.3,-- яйцо не может замедлить сильнее, чем до 30%
	SpawnMaxWeight = 100000,   -- самое тяжёлое яйцо в биоме, если у биома не указан MaxWeight (Config/Biomes)
	SpawnRollPower = 3,      -- чем больше число, тем реже спавнятся тяжёлые яйца
}

-- Скорость игрока
GameConfig.Speed = {
	StartStat = 1,           -- игрок начинает со скорости 1
	BaseWalkSpeed = 16,      -- реальная скорость персонажа при стате 1 (стандарт Roblox)
	WalkSpeedPerLog = 16,    -- +16 к реальной скорости за каждые x10 статы
	MaxWalkSpeed = 350,      -- предел реальной скорости.
	                         -- ВАЖНО: при 350 персонаж проходит ~6 студов за кадр,
	                         -- поэтому стены тоньше 8 студов он может проскочить насквозь.
	                         -- Делай ворота и границы биомов толстыми (или ставь
	                         -- позади тонкого забора невидимую толстую стену).

	-- Серверная проверка скорости (защита от ускорителей)
	CheckInterval = 0.5,     -- как часто сервер смотрит, куда переместился игрок
	CheckTolerance = 1.6,    -- запас на лаги: во сколько раз можно превысить расчётную скорость
	CheckSlack = 12,         -- плюс столько студов прощаем на каждой проверке
	CheckStrikes = 2,        -- сколько проверок подряд должно не сойтись, прежде чем вернуть назад
}

-- Беговая дорожка (прибавка обычными числами, не процентами).
-- Игрок встаёт на дорожку — скорость капает, пока он на ней стоит.
GameConfig.Treadmill = {
	BaseGain = 1,            -- скорость в секунду на уровне 0
	GainPerLevel = 1,        -- +1 к прибавке за каждый уровень улучшения
	UpgradeBaseCost = 1200,   -- цена первого улучшения
	UpgradeCostGrowth = 1.5, -- каждое следующее улучшение дороже в 1.5 раза
	MaxLevel = 100,
	StandHeight = 8,         -- на сколько студов над дорожкой ещё считается, что игрок на ней

	-- Игрок встаёт на дорожку, прилипает к ней и бежит на месте.
	-- Каждые GainInterval секунд он получает BaseGain + уровень (умноженное на трейл
	-- и геймпасс), и над головой всплывает цифра.
	-- Внимание: прибавка в секунду = прибавка за шаг / GainInterval.
	-- При шаге 0.2 секунды дорожка даёт в 5 раз больше скорости, чем при шаге 1 секунда.
	GainInterval = 0.5,      -- как часто капает скорость
	ExitCooldown = 0.8,      -- сколько не приклеивать обратно после прыжка

	-- Анимация бега на месте. Это стандартные анимации Roblox — они работают у всех.
	-- Свою анимацию можно вставить сюда, но она должна принадлежать тому же
	-- аккаунту (или группе), что и игра, иначе Roblox её не загрузит.
	RunAnimationR15 = "rbxassetid://913376220",
	RunAnimationR6 = "rbxassetid://180426354",
	RunAnimationSpeed = 1.6, -- во сколько раз быстрее крутить анимацию
}

